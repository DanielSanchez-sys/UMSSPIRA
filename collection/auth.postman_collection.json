{
  "info": {
    "name": "auth",
    "description": "Pruebas del modulo auth (HU-05). Requiere los usuarios de prueba del seed. No guardar contrasenas reales en este archivo: definirlas como variables de entorno en Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "tituladoEmail", "value": "titulado@example.com" },
    { "key": "tituladoPassword", "value": "" },
    { "key": "unknownEmail", "value": "no-existe@example.com" }
  ],
  "item": [
    {
      "name": "POST /api/auth/login - administrador valido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('devuelve accessToken', () => pm.expect(body.data.accessToken).to.be.a('string').and.not.empty);",
              "pm.test('rol es administrador', () => pm.expect(body.data.role).to.eql('administrador'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "POST /api/auth/login - titulado valido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('devuelve accessToken', () => pm.expect(body.data.accessToken).to.be.a('string').and.not.empty);",
              "pm.test('rol es titulado', () => pm.expect(body.data.role).to.eql('titulado'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{tituladoEmail}}\",\n  \"password\": \"{{tituladoPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "POST /api/auth/login - contrasena incorrecta (CA-05.4)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('mensaje generico', () => pm.expect(body.error).to.eql('Correo electrónico o contraseña incorrectos'));",
              "pm.test('no devuelve token', () => pm.expect(body.data).to.be.undefined);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"contrasena-incorrecta-123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "POST /api/auth/login - correo no registrado (CA-05.4)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('mismo mensaje generico que contrasena incorrecta', () => pm.expect(body.error).to.eql('Correo electrónico o contraseña incorrectos'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{unknownEmail}}\",\n  \"password\": \"cualquier-contrasena-123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "POST /api/auth/login - correo con formato invalido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('devuelve mensaje de error', () => pm.expect(body.error).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"correo-sin-arroba\",\n  \"password\": \"cualquier-contrasena-123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "POST /api/auth/login - contrasena vacia",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('devuelve mensaje de error', () => pm.expect(body.error).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "POST /api/auth/login - cuerpo vacio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    }
  ]
}